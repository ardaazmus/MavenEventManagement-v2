# ==============================================================================
# Maven Event Management v2 — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for development/local evaluation):
DATABASE_URL="file:../db/custom.db"
# PostgreSQL / MySQL (for enterprise deployment):
# DATABASE_URL="postgresql://user:password@localhost:5432/maven_db?schema=public"

# ── Authentication & Security ─────────────────────────────────────────────────
# MAVEN_AUTH: Set to "on" to enforce strict authentication & RBAC.
# If "off", demo/dev bypass mode is enabled (in production, MAVEN_AUTH=off fails closed).
MAVEN_AUTH="off"

# Secret key used for signing session cookies (minimum 32 characters required in production):
MAVEN_SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"

# Secret key for anti-bot form challenge derivation:
MAVEN_CHALLENGE_SECRET="replace-with-a-secure-form-challenge-secret"

# Key for privileged super-admin operations:
# MAVEN_SUPERADMIN_KEY="replace-with-superadmin-key-if-needed"

# ── Host & Domain Configuration ──────────────────────────────────────────────
# Application public origin (used in auth callbacks and payment redirects):
MAVEN_ORIGIN="http://localhost:3000"

# WebAuthn Relying Party ID:
MAVEN_RPID="localhost"

# Proxy trust header handling (set to "off" if not running behind a reverse proxy):
MAVEN_TRUST_PROXY="on"

# ── Payment Providers (Sandbox / Optional) ───────────────────────────────────
# IYZICO_BASE="https://sandbox-api.iyzipay.com"
# IYZICO_API_KEY="sandbox-api-key-placeholder"
# IYZICO_SECRET="sandbox-secret-key-placeholder"

# ── Event Bus / Internal Services ────────────────────────────────────────────
# LIVE_BUS_KEY="dev-live-bus-secret-key"
