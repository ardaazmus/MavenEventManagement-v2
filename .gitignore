dev.log
dev.out.log
server.log

# env files (P00.2 hygiene: keep .env local, allow .env.example)
.env
.env*.local
.env.production
.env.staging
.env*
!.env.example

# database runtime files & local backups (P00.2 hygiene)
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal
db/*.db.bak*
db/*.bak*
db/backup*/

# vercel
.vercel

