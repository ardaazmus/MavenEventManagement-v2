// Maven Event Management — Ortak Organizasyonel Mimari
// Bu şema, docs/Maven_Event_Management_Ortak_Organizasyonel_Mimari.md §3 ile birebir eşleşir.
// SQLite kısıtı: enum yerine String + src/lib/constants.ts sabitleri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── 1. ORGANİZASYON ────────────────────────────────────────

model Organization {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  mission     String?
  logoUrl     String?
  foundedYear Int?
  contactEmail String?
  contactPhone String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events   Event[]
  venues   Venue[]
  speakers Speaker[]
}

model Department {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  color       String?     // UI vurgu rengi
  parentId    String?     // self-relation: hiyerarşik birim ağacı
  managerId   String?     // Birim yöneticisi
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DeptTree")
  manager     Member?      @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     Member[]     @relation("DeptMembers")

  @@index([parentId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  level       Int      @default(5) // 1=Yönetici … 5=Gönüllü
  description String?
  color       String?
  createdAt   DateTime @default(now())

  members Member[]
}

model Member {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  email        String       @unique
  phone        String?
  avatarUrl    String?
  studentNo    String?
  bio          String?
  departmentId String?
  roleId       String?
  status       String       @default("ACTIVE") // ACTIVE | PASSIVE | ALUMNI
  joinDate     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department   Department?  @relation("DeptMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  managedDepts Department[] @relation("DeptManager")
  teamMembers  TeamMember[]
  ledTeams     Team[]       @relation("TeamLeader")
  tasks        Task[]       @relation("TaskAssignee")
  createdTasks Task[]       @relation("TaskCreator")
  coordinatedEvents Event[] @relation("EventCoordinator")
  announcements Announcement[]
}

// ─── 2. EKİPLER ─────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("EVENT") // STANDING | EVENT
  eventId     String?  // null → daimi ekip
  leaderId    String?
  color       String?
  createdAt   DateTime @default(now())

  event   Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader  Member?      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members TeamMember[]
  tasks   Task[]

  @@index([eventId])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  memberId   String
  roleInTeam String   @default("MEMBER") // LEADER | COORDINATOR | MEMBER
  joinedAt   DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
}

// ─── 3. ETKİNLİK ────────────────────────────────────────────

model Event {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String?
  type                String    @default("MEETUP") // §3.1 EventType
  status              String    @default("DRAFT")  // DRAFT→PLANNING→PUBLISHED→ONGOING→COMPLETED | CANCELLED
  startDate           DateTime
  endDate             DateTime
  registrationDeadline DateTime?
  venueId             String?
  coordinatorId       String?
  organizationId      String?
  capacity            Int       @default(100)
  plannedBudget       Float     @default(0)
  coverColor          String?   // UI kapak rengi
  tags                String?   // virgülle ayrılmış
  isFeatured          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  venue        Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  coordinator  Member?     @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teams        Team[]
  tasks        Task[]
  budgetItems  BudgetItem[]
  expenses     Expense[]
  sponsors     Sponsor[]
  sessions     Session[]
  ticketTypes  TicketType[]
  attendees    Attendee[]
  announcements Announcement[]
  feedbacks    Feedback[]

  @@index([status])
  @@index([startDate])
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String?
  district    String?
  capacity    Int      @default(0)
  contactName String?
  contactPhone String?
  hourlyRate  Float?
  notes       String?
  createdAt   DateTime @default(now())

  events Event[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

// ─── 4. GÖREVLER ────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventId     String
  teamId      String?
  assigneeId  String?
  createdById String?
  status      String    @default("BACKLOG") // BACKLOG|TODO|IN_PROGRESS|REVIEW|DONE|BLOCKED
  priority    String    @default("MEDIUM")  // LOW|MEDIUM|HIGH|URGENT
  dueDate     DateTime?
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team       Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee   Member?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    Member?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  checklist  TaskChecklistItem[]

  @@index([eventId])
  @@index([status])
}

model TaskChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  isDone   Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── 5. FİNANS ──────────────────────────────────────────────

model BudgetItem {
  id            String  @id @default(cuid())
  eventId       String
  category      String  // §3.1 BudgetCategory
  description   String?
  plannedAmount Float   @default(0)
  actualAmount  Float   @default(0)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([eventId])
}

model Expense {
  id           String   @id @default(cuid())
  budgetItemId String?
  eventId      String
  title        String
  amount       Float    @default(0)
  date         DateTime @default(now())
  status       String   @default("PENDING") // PENDING|APPROVED|REJECTED|PAID
  receiptNo    String?
  paidBy       String?
  note         String?
  createdAt    DateTime @default(now())

  budgetItem BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─── 6. SPONSOR & AJANDA ────────────────────────────────────

model Sponsor {
  id               String  @id @default(cuid())
  eventId          String
  name             String
  tier             String  @default("BRONZE") // PLATINUM|GOLD|SILVER|BRONZE|MEDIA|PARTNER
  status           String  @default("PROSPECT") // PROSPECT|CONTACTED|NEGOTIATION|CONFIRMED|DECLINED
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  logoUrl          String?
  website          String?
  sponsorshipAmount Float  @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Speaker {
  id        String   @id @default(cuid())
  name      String
  title     String?
  company   String?
  bio       String?
  photoUrl  String?
  email     String?
  linkedin  String?
  twitter   String?
  organizationId String?
  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions     Session[]
}

model Session {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  type        String   @default("TALK") // KEYNOTE|TALK|PANEL|WORKSHOP|BREAK|NETWORKING
  speakerId   String?
  startTime   DateTime
  endTime     DateTime
  room        String?
  capacity    Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// ─── 7. KATILIM & İLETİŞİM ──────────────────────────────────

model TicketType {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  description  String?
  price        Float    @default(0)
  quantity     Int      @default(0)
  isActive     Boolean  @default(true)
  saleStart    DateTime?
  saleEnd      DateTime?
  createdAt    DateTime @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees Attendee[]

  @@index([eventId])
}

model Attendee {
  id               String   @id @default(cuid())
  eventId          String
  ticketTypeId     String?
  firstName        String
  lastName         String
  email            String
  phone            String?
  company          String?
  title            String?
  status           String   @default("REGISTERED") // REGISTERED|CONFIRMED|CHECKED_IN|CANCELLED|NO_SHOW
  qrCode           String   @unique @default(cuid())
  registrationDate DateTime @default(now())
  checkInAt        DateTime?
  notes            String?

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([eventId])
}

model Announcement {
  id         String   @id @default(cuid())
  eventId    String?  // null → organizasyon geneli
  title      String
  content    String
  priority   String   @default("NORMAL") // NORMAL|IMPORTANT|CRITICAL
  authorId   String?
  pinned     Boolean  @default(false)
  publishDate DateTime @default(now())

  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author Member? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  type       String   // EVENT_CREATED, TASK_COMPLETED, SPONSOR_ADDED …
  message    String
  entityType String?
  entityId   String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Feedback {
  id          String   @id @default(cuid())
  eventId     String
  attendeeId  String?
  rating      Int      @default(5) // 1-5
  category    String?  // PROGRAM, ORGANIZATION, VENUE, OTHER
  comment     String?
  submittedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
